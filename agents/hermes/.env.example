# Hermes Agent — Example Environment Variables
# Copy this to .env and fill in real values.

# ── Telegram Bot ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABCdef...          # from @BotFather
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/webhook  # or leave blank for polling
TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321   # comma-separated, restricts access

# ── Claude / Anthropic ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Hermes config ────────────────────────────────────────────────────────────
HERMES_MODEL=claude-opus-4-7
HERMES_LOG_LEVEL=INFO

# ── Future integrations (fill in as you connect) ─────────────────────────────
NOTION_TOKEN=secret_...
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLICKUP_API_KEY=pk_...
CLICKUP_LIST_ID=xxxxxxxxx
FIREFLIES_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
STRIPE_API_KEY=rk_live_...
