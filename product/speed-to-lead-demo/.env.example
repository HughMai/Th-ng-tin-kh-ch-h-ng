# Copy this file to .env and fill in real values.

# --- Claude (conversation engine) -------------------------------------------
# https://console.anthropic.com  ->  Settings  ->  API keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Twilio (telephony) -----------------------------------------------------
# https://console.twilio.com  ->  Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
# The Twilio number you bought, E.164 format. e.g. +15005550006
TWILIO_NUMBER=+1XXXXXXXXXX

# Where escalations and missed-call alerts go. For the demo, your own mobile.
# E.164 format. e.g. +61400000000
ELECTRICIAN_MOBILE=+61XXXXXXXXX

# --- App --------------------------------------------------------------------
# Public hostname Twilio reaches this app on — no scheme, no slashes.
# Caddy gets a free Let's Encrypt cert for it automatically; the app derives
# PUBLIC_BASE_URL from it for Twilio webhook-signature verification.
# sslip.io gives a free hostname from any IP — <anything>.<ip-dashed>.sslip.io
# resolves to that IP. e.g. stl.187-77-133-39.sslip.io for the Hermes VPS.
PUBLIC_HOSTNAME=stl.your-ip-dashed.sslip.io

# SQLite file holding conversation state and the lead log.
DB_PATH=data/leads.db

# --- Lead capture (web simulator → Telegram + JSONL) ------------------------
# Reuses the @BaoBei09bot Hermes already runs. The token lives in
# /opt/data/.env on the VPS; the deploy step copies it into this .env.
# CHAT_ID is your Telegram user ID — get from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=8720641622

# JSONL file where captured demo leads land (one JSON object per line).
LEADS_PATH=data/leads.jsonl
