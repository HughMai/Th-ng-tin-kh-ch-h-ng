# Copy this file to .env and fill in real values.

# --- Claude (conversation engine) -------------------------------------------
# https://console.anthropic.com  ->  Settings  ->  API keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Twilio (telephony) -----------------------------------------------------
# https://console.twilio.com  ->  Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
# The Twilio number you bought, E.164 format. e.g. +15005550006
TWILIO_NUMBER=+1XXXXXXXXXX
# AU numbers also require an approved regulatory bundle. Pass its BU... SID to
# provision_number.py with --bundle-sid; the SID is not a secret.

# Where escalations and missed-call alerts go. For the demo, your own mobile.
# E.164 format. e.g. +61400000000
ELECTRICIAN_MOBILE=+61XXXXXXXXX

# --- Google Calendar (booking) ----------------------------------------------
# OAuth client from Google Cloud Console -> Credentials. Used by gcal.py to
# create events. Two ways a tenant connects (both store a per-tenant refresh
# token on their config):
#   - Self-serve: client clicks "Connect Google Calendar" on their dashboard.
#     Requires a "Web application" OAuth client with this authorized redirect
#     URI: https://<PUBLIC_HOSTNAME>/oauth/google/callback  (for local testing
#     also add http://127.0.0.1:8000/oauth/google/callback).
#   - Operator CLI: python connect_calendar.py --tenant <id>  (uses a Desktop
#     app client; only needed if you'd rather connect it for them).
# While the OAuth app is in "Testing" mode only added test users can connect and
# tokens expire after 7 days; move it to "Production" for real clients.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- App --------------------------------------------------------------------
# Public hostname Twilio reaches this app on — no scheme, no slashes.
# Caddy gets a free Let's Encrypt cert for it automatically; the app derives
# PUBLIC_BASE_URL from it for Twilio webhook-signature verification.
# sslip.io gives a free hostname from any IP — <anything>.<ip-dashed>.sslip.io
# resolves to that IP. e.g. stl.187-77-133-39.sslip.io for the Hermes VPS.
PUBLIC_HOSTNAME=stl.your-ip-dashed.sslip.io

# SQLite file holding conversation state and the lead log.
DB_PATH=data/leads.db

# Owner dashboard / client logins.
# DASHBOARD_TOKEN: admin quick-access via /dashboard?key=<this>.
# SECRET_KEY: signs login session cookies (falls back to DASHBOARD_TOKEN). Set a
#   long random string in production so cookies survive restarts.
# ADMIN_USERNAME/PASSWORD: your own login at /login (sees every tenant).
# Clients get their own logins via create_account.py (stored in data/accounts.json).
DASHBOARD_TOKEN=
SECRET_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
