# Copy this file to .env and fill in real values.

# --- Claude (conversation engine) -------------------------------------------
# https://console.anthropic.com  ->  Settings  ->  API keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Twilio (telephony) -----------------------------------------------------
# https://console.twilio.com  ->  Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
# The Twilio number you bought, E.164 format. e.g. +15005550006
TWILIO_NUMBER=+1XXXXXXXXXX
# AU numbers also require an approved regulatory bundle. Pass its BU... SID to
# provision_number.py with --bundle-sid; the SID is not a secret.

# --- Website "get a demo call" form (leadresponder.netlify.app) --------------
# Public hero form -> Netlify Forms -> submission-created function ->
# POST /api/demo-call -> outbound AI callback. These gate + bound that endpoint.
# Shared secret between the Netlify function and this app. Generate a long random
# string and set the SAME value in Netlify env as DEMO_CALL_SECRET.
DEMO_CALL_SECRET=
# Caller ID shown to the prospect. The live AU line +61468089224 (shared with
# crown-st-auto / rapidflow as caller ID only; the demo brain is isolated).
DEMO_FROM_NUMBER=+61468089224
# Global cap on demo callbacks per day (UTC). Bounds Twilio spend if abused.
DEMO_DAILY_CAP=20

# Where escalations and missed-call alerts go. For the demo, your own mobile.
# E.164 format. e.g. +61400000000
ELECTRICIAN_MOBILE=+61XXXXXXXXX

# --- Deepgram (live voice agent) ---------------------------------------------
# https://console.deepgram.com -> API Keys. The Voice Agent API hosts STT +
# turn-taking + TTS + the Claude brain over one WebSocket.
# Your existing var name `Deepgram_API` is read as a fallback.
DEEPGRAM_API_KEY=
# Conversational STT / turn-taking. Flux is lower-latency and purpose-built for
# voice agents. Raise thresholds if it cuts callers off; lower them if it waits.
DEEPGRAM_LISTEN_MODEL=flux-general-en
DEEPGRAM_LISTEN_VERSION=v2
DEEPGRAM_EOT_THRESHOLD=0.65
DEEPGRAM_EAGER_EOT_THRESHOLD=0.45
DEEPGRAM_EOT_TIMEOUT_MS=1500
# Aura-2 voice name. Hyperion is Australian, warm and trade-friendly. Try
# aura-2-theia-en if you want a female Australian voice.
DEEPGRAM_VOICE=aura-2-hyperion-en
# Optional TTS swap: Deepgram-managed Cartesia Sonic-2. To test, set
# DEEPGRAM_TTS_PROVIDER=cartesia. Default voice is "Australian Woman" (female,
# AU accent). Verify it resolves on Sonic-2 via /voice/probe; the Cartesia API
# key likely needs registering in the Deepgram console (like the think key).
DEEPGRAM_TTS_PROVIDER=deepgram
CARTESIA_MODEL_ID=sonic-2
CARTESIA_VOICE_ID=043cfc81-d69f-4bee-ae1e-7862cb358650
CARTESIA_SPEED=normal
# Hosted LLM model - must be on Deepgram's managed allowlist. Haiku is the
# live-call default for latency; use claude-sonnet-4-6 only when reasoning
# quality beats speed for a tenant. The older claude-sonnet-4-20250514 is
# allowlisted but 404s upstream at Anthropic now.
DEEPGRAM_THINK_MODEL=claude-haiku-4-5
VOICE_DEBUG_EVENTS=0
# Re-ask the last agent question after silence. Set <=0 to disable.
# 7000ms = a real reply window (was 2000, which re-asked before the caller could speak).
VOICE_SILENCE_REPROMPT_MS=7000
# If caller speech starts but no transcript arrives, recover instead of stalling.
VOICE_UNCLEAR_SPEECH_MS=6000

# --- Call watchdog: end loops, dead air, overruns ---------------------------
# The hosted Deepgram brain re-asks the same question on its OWN turn-taking
# (line echo / false endpointing -> extra LLM turns). These knobs end the call
# instead of looping forever. All optional — defaults are baked into the code.
VOICE_MAX_CALL_SEC=240          # hard cap. "end at 4 minutes" = 240.
VOICE_SILENCE_HANGUP_SEC=25     # no caller speech this long -> hang up (pocket dial / dead air)
VOICE_LOOP_MAX_REPEATS=2        # >=N identical agent turns -> hang up (the "repeats itself" bug)
VOICE_LOOP_WINDOW_SEC=6         # only count repeats closer than this (our 7s nudge never counts)

# --- Google Calendar (booking) ----------------------------------------------
# OAuth client from Google Cloud Console -> Credentials. Used by gcal.py to
# create events. Two ways a tenant connects (both store a per-tenant refresh
# token on their config):
#   - Self-serve: client clicks "Connect Google Calendar" on their dashboard.
#     Requires a "Web application" OAuth client with this authorized redirect
#     URI: https://<PUBLIC_HOSTNAME>/oauth/google/callback  (for local testing
#     also add http://127.0.0.1:8000/oauth/google/callback).
#   - Operator CLI: python connect_calendar.py --tenant <id>  (uses a Desktop
#     app client; only needed if you'd rather connect it for them).
# While the OAuth app is in "Testing" mode only added test users can connect and
# tokens expire after 7 days; move it to "Production" for real clients.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- App --------------------------------------------------------------------
# Public hostname Twilio reaches this app on — no scheme, no slashes.
# Caddy gets a free Let's Encrypt cert for it automatically; the app derives
# PUBLIC_BASE_URL from it for Twilio webhook-signature verification.
# sslip.io gives a free hostname from any IP — <anything>.<ip-dashed>.sslip.io
# resolves to that IP. e.g. stl.187-77-133-39.sslip.io for the Hermes VPS.
PUBLIC_HOSTNAME=stl.your-ip-dashed.sslip.io

# SQLite file holding conversation state and the lead log.
DB_PATH=data/leads.db

# Owner dashboard / client logins.
# DASHBOARD_TOKEN: admin quick-access via /dashboard?key=<this>.
# SECRET_KEY: signs login session cookies (falls back to DASHBOARD_TOKEN). Set a
#   long random string in production so cookies survive restarts.
# ADMIN_USERNAME/PASSWORD: your own login at /login (sees every tenant).
# Clients get their own logins via create_account.py (stored in data/accounts.json).
# CLIENT_LOGIN_URL: public URL printed by create_account.py for client handoff.
DASHBOARD_TOKEN=
SECRET_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
CLIENT_LOGIN_URL=https://leadresponder.netlify.app/login

# --- Synthetic canary (catches silent breakage before a customer does) -------
# canary.py probes /health/deep over the public URL and alerts on @BaoBei09bot.
# Run it OFF this box (GitHub Actions cron or another host) so a dead VPS still
# alerts. CANARY_TOKEN gates /health/deep so it can't be abused to burn API
# calls — set the SAME value here (the app) and in the canary's environment.
CANARY_TOKEN=
# These are read by canary.py (the runner), not the app:
#   BAOBEI_BOT_TOKEN  @BaoBei09bot token (or reuse TELEGRAM_BOT_TOKEN)
#   CANARY_CHAT_ID    your Telegram chat id to alert
#   CANARY_URL        override probe url (default https://<PUBLIC_HOSTNAME>/health/deep)
#   CANARY_TIMEOUT    seconds before the probe counts as failed (default 25)
