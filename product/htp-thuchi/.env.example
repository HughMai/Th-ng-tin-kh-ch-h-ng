# Chuỗi ngẫu nhiên dài để ký cookie phiên đăng nhập (khác CRM)
SESSION_SECRET=long-random-string

# Ai được vào sổ. Mỗi người một mật khẩu riêng, cách nhau bằng dấu ;
# Dạng: Tên:mật-khẩu;Tên:mật-khẩu
# Tên hiện lên mỗi dòng đã nhập ("· Ba Mẹ"), nên đặt ngắn gọn.
# ĐỔI HẾT trước khi deploy. Kế toán là người ngoài nhà — đừng dùng chung mật
# khẩu với CRM.
USERS=Ba Mẹ:doi-mat-khau-nay;Kế toán:doi-mat-khau-nay-2;Hughie:doi-mat-khau-nay-3

DB_PATH=data/thuchi.db

# Ngày bắt đầu dùng sổ (YYYY-MM-DD). Tiền đã thu bên CRM chỉ hiện từ ngày này
# trở đi — tháng cũ chưa ghi chi nên hiện lên sẽ lệch.
START_DATE=2026-07-23

# CRM — nguồn tiền khách trả (cọc, thanh toán, công nợ đại lý) tự chảy vào Thu.
# THUCHI_TOKEN phải giống hệt THUCHI_TOKEN trong /opt/htp-crm/.env
# Để trống CRM_URL thì app vẫn chạy, chỉ không có phần "từ CRM".
CRM_URL=http://htp-crm-app:8000
THUCHI_TOKEN=

# Session cookies là Secure mặc định. Chỉ đặt COOKIE_INSECURE=1 khi chạy http
# ở máy local; production để trống.
COOKIE_INSECURE=
