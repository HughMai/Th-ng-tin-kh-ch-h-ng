# Mật khẩu chung cả nhà dùng để đăng nhập (đổi trước khi deploy!)
FAMILY_PASSWORD=doi-mat-khau-nay
# Chuỗi ngẫu nhiên dài để ký cookie phiên đăng nhập
SESSION_SECRET=long-random-string
DB_PATH=data/htp.db
# Hostname công khai (Caddy dùng làm nhãn TLS)
PUBLIC_HOSTNAME=crm.187-77-133-39.sslip.io
# Session cookies are Secure by default. Set COOKIE_INSECURE=1 ONLY for http
# local dev (localhost); leave unset in production so cookies stay TLS-only.
COOKIE_INSECURE=

# Zalo OA API — App ID/Secret from developers.zalo.me (app linked to the OA)
ZALO_APP_ID=
ZALO_APP_SECRET=
# Shared-secret query param the webhook route checks (?token=...) — set this as
# part of the webhook URL you register in developers.zalo.me
ZALO_WEBHOOK_TOKEN=
# Access/refresh tokens are NOT stored here — they're written to
# data/zalo_tokens.json by the OAuth flow at /zalo/oauth/start

# Tiêu đề công ty in trên Báo Giá xuất ra (.xlsx). Mặc định là thông tin thật
# của HTP (theo mẫu báo giá); để trống field nào thì dòng đó không hiện.
COMPANY_NAME=HƯNG THÀNH PHÁT DOOR
COMPANY_TAGLINE=Cửa Cuốn · Cửa Kéo · Cửa Nhôm Kính
COMPANY_PHONE=0945 042 345 | 0913 574 077
COMPANY_ADDRESS=235 - 237 (281 Cũ) Võ Văn Kiệt, Bình Thủy, Cần Thơ
COMPANY_EMAIL=hungthanhphat6688@gmail.com
COMPANY_WEBSITE=hungthanhphat.vn

# Bot Zalo nhóm — tuỳ chọn (bỏ trống thì CRM chạy bình thường, không có bot).
# Chuỗi bí mật dùng chung giữa CRM và bot (đặt dài, ngẫu nhiên).
BOT_TOKEN=
# URL nội bộ tới container bot (không cần đổi nếu dùng docker-compose kèm theo).
BOT_URL=http://htp-crm-bot:8100
# URL nội bộ tới container CRM, bot dùng để gọi ngược lại.
CRM_URL=http://htp-crm-app:8000
# id nhóm Zalo (threadId) — để trống lúc đầu; bot sẽ log threadId của nhóm khi
# có ai nhắn (chế độ "discovery"), điền vào đây rồi khởi động lại container bot.
GROUP_THREAD_ID=
# Giờ gửi bảng công việc mỗi sáng (0-23, giờ Việt Nam).
DIGEST_HOUR=7
